# Copy to .env.local for local development.
# Set the same two variables in Vercel under Settings > Environment Variables.
# The anon key is safe to expose in the browser. The service role key is NOT.
# Never put a service role key in any VITE_ variable.

VITE_SUPABASE_URL=https://ymnqgfpnfzrlinbdbkel.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_anon_key

# --- PayPal ---
# The client id is public and ships in the browser bundle. That is by design.
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
# sandbox or live. Start with sandbox.
VITE_PAYPAL_ENV=sandbox

# Server side only. These must NEVER be prefixed with VITE_, or they would be
# compiled into the browser bundle where anyone can read them.
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id

# Supabase service role key. Server side only, never VITE_ prefixed.
SUPABASE_URL=https://ymnqgfpnfzrlinbdbkel.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
